  "cards": [
    {
      "dot": "cyan",
      "title": "会话池与进程隔离",
      "items": [
        "MCPSessionPool 以 (server, scope, loop) 为键实施三元组严格隔离",
        "Stdio 工作目录限定在 thread workspace，临时目录隔离至 .mcp/tmp/",
        "遇到连接断开错误时自动从活跃注册表中剔除并重建会话"
      ]
    },
    {
      "dot": "emerald",
      "title": "异步长任务保障机制",
      "items": [
        "普通长任务将 submit/status/cancel 解耦，仅对模型暴露 submit",
        "后台 McpTaskService 通过租约机制与每轮次 Token 锁防止竞争",
        "任务到达 input_required 或终端状态后通过幂等 Agent 运行回传"
      ]
    }
  ]
