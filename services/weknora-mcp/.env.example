# WeKnora API root reachable from this service. Do not use 0.0.0.0 as a client target.
WEKNORA_BASE_URL=http://weknora:8080/api/v1
WEKNORA_API_KEY=replace-with-retrieve-only-key
WEKNORA_KB_IDS=11111111-1111-4111-8111-111111111111
# Required only for a platform API key:
# WEKNORA_TENANT_ID=tenant-id

# A distinct, high-entropy credential used only between DeerFlow and this MCP service.
MCP_SERVER_AUTH_TOKEN=replace-with-a-distinct-random-service-token
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Host values include the port received by the service. Use :* only when the port is dynamic.
MCP_ALLOWED_HOSTS=weknora-mcp:8000,127.0.0.1:8000,localhost:8000
# MCP clients normally omit Origin. Add browser/reverse-proxy origins only when required.
MCP_ALLOWED_ORIGINS=

# Compose publishes loopback by default. Set an explicit private address only when required.
MCP_BIND_HOST=127.0.0.1
MCP_PUBLISHED_PORT=8000

